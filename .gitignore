# Local secrets and dev state. The pairing token lives in DPAPI-protected
# storage under %LOCALAPPDATA%, not in the repo, but a stray appsettings with a
# host and a token in it is the easy mistake.
appsettings.Development.json
appsettings.Local.json
*.local.json
.env

